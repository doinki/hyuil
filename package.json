{
  "name": "hyuil",
  "version": "0.1.1",
  "description": "한국의 공휴일을 조회할 수 있는 MCP 서버",
  "keywords": [
    "holiday",
    "hyuil",
    "mcp"
  ],
  "homepage": "https://github.com/doinki/hyuil",
  "bugs": "https://github.com/doinki/hyuil/issues",
  "license": "MIT",
  "author": {
    "name": "doinki",
    "email": "doinki94@gmail.com",
    "url": "https://github.com/doinki"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinki/hyuil.git"
  },
  "bin": {
    "hyuil": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --hot src/app.ts",
    "build": "bun build src/app.ts --outdir dist --format esm --target bun",
    "build:mcp": "bun build mcp/index.ts --banner '#!/usr/bin/env node' --format esm --outdir build --packages external --target node",
    "start": "NODE_ENV=production bun dist/app.js",
    "release": "bun run build:mcp && publint && changeset publish",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@hono/mcp": "^0.3.2",
    "@types/bun": "^1.4.2",
    "dotenv": "^18.0.1",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "hono": "^4.13.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lru-cache": "^11.5.3",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "oxlint-tsgolint": "^7.0.2002",
    "pretty-cache-header": "^1.0.0",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
